# --- Phaze MCP. Served by the Phaze app on this computer once the experimental
# MCP feature is on in client settings. It acts as whoever is signed in to the app.
# Help: https://help.phaze.app/articles/6522930271-the-phaze-mcp-server
PHAZE_MCP_URL=http://127.0.0.1:41010/mcp

# --- Phaze Enterprise API (optional). You can also paste the key into the web page instead.
# Adds org names, owners and OS to the machine list. Needs an administrator account:
# https://admin.phaze.app/settings  ·  Help: https://help.phaze.app/articles/6515713992-the-phaze-api
PHAZE_API_KEY=

# --- Claude (optional, recommended): reads the screenshots. https://console.anthropic.com
# Without a key, Render Buddy still works but can only say "the screen stopped changing".
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Slack (optional): without these, notifications print in the console.
# Bot token (xoxb-...) with chat:write and files:write. Invite the bot to the channel.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write, for Socket Mode (needed for the buttons).
SLACK_APP_TOKEN=
# Channel ID (C...) where render threads are posted.
SLACK_CHANNEL=

# --- Watching ---
CHECK_INTERVAL_SEC=60
# Screen unchanged for this long = suspected stall.
STALL_MINUTES=10
# Ask Claude at least this often, to keep progress and ETA fresh.
HEARTBEAT_MINUTES=15
PORT=8765
